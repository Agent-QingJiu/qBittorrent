#!/bin/sh
. "$(dirname "$0")/common"
check_target
if [ -e "$store" ] || [ -L "$store" ]; then
    check_store
    exit 0
fi
if id "$account" >/dev/null 2>&1; then
    fail "专用账号 $account 已存在，无法确认归属。"
fi
umask 077
mkdir -p -m 755 "$parent"
staging=$(mktemp -d "$parent/.qbittorrent-install.XXXXXX")
account_created=no
cleanup() {
    if [ -n "$staging" ]; then
        rm -rf -- "$staging"
        if [ "$account_created" = yes ]; then
            /usr/syno/sbin/synouser --del "$account"
        fi
    fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
"$helper" credential > "$staging/credential"
IFS= read -r password < "$staging/credential"
hash=$(sed -n '2p' "$staging/credential")
[ -n "$password" ] && [ -n "$hash" ] || fail "初始密码生成失败。"
account_password=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
/usr/syno/sbin/synouser --add "$account" "$account_password" 'qBittorrent service' 0 '' 0
account_created=yes
id -u "$account" > "$staging/.managed"
mkdir -m 700 "$staging/Profile" "$staging/Logs"
mkdir -p "$staging/Profile/qBittorrent/config"
printf '账号：admin（登录时输入 admin）\n密码：%s\n' "$password" > "$staging/初始登录.txt"
rm "$staging/credential"
cat > "$staging/Profile/qBittorrent/config/qBittorrent.conf" <<CONF
[LegalNotice]
Accepted=true

[Preferences]
General\Locale=zh_CN
WebUI\Address=*
WebUI\Port=8080
WebUI\Username=admin
WebUI\Password_PBKDF2=@ByteArray($hash)
WebUI\LocalHostAuth=true
WebUI\AuthSubnetWhitelistEnabled=false
WebUI\UseUPnP=false

[BitTorrent]
Session\Port=6881
CONF
chown -R "$account" "$staging/Profile" "$staging/Logs"
chmod 755 "$staging"
mv -T "$staging" "$store"
staging=
check_store
